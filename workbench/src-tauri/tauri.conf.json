{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Translation Workbench",
  "version": "0.1.0",
  "identifier": "org.aristotlereader.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Translation Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com https://raw.githubusercontent.com",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/corpus/**", "$RESOURCE/corpus/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": ["resources/reference.docx", "resources/corpus/"]
  }
}
